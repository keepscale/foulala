# Copier en .env (jamais commité) et remplir.
DOMAIN=api.foulala.example
POSTGRES_PASSWORD=change-moi
AUTHENTICATOR_PASSWORD=change-moi-aussi
# Secret de signature des jetons organisateurs, 32 caractères au moins :
#   openssl rand -base64 48
JWT_SECRET=change-moi-avec-au-moins-32-caracteres-aleatoires
# Adresse de la page organisateur (CORS), sans / final
WEB_ORIGIN=https://orga.foulala.example
