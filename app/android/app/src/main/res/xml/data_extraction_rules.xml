<?xml version="1.0" encoding="utf-8"?>
<!-- Vie privée : depuis Android 12, allowBackup="false" ne bloque plus le transfert
     d'appareil à appareil. On exclut tout, des deux côtés : jetons, file d'envoi et
     soutiens ne quittent jamais ce téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
