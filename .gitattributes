# Fichiers exécutés dans les conteneurs Linux : toujours en LF, même sous Windows
# (sinon `#!/usr/bin/env bash\r` fait échouer l'initialisation de la base).
*.sh       text eol=lf
*.sql      text eol=lf
Caddyfile  text eol=lf

# Dart en LF : les fichiers *.g.dart sont comparés à la sortie du générateur
# (test/tokens_test.dart), qui écrit en LF.
*.dart     text eol=lf
